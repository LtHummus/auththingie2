{{template "base.gohtml"}}

{{define "title"}}Account Disabled{{end}}

{{define "content"}}
    <div id="forbidden-container" class="at-page at-narrow">
        <hgroup>
            <h1>Account Disabled</h1>
            <h2>Your account is switched off for now</h2>
        </hgroup>

        <article>
            <p>Your account has been disabled. You are currently logged in as <strong>{{ .Username }}</strong></p>
            <p>
                Nothing has been deleted. An admin can turn the account back on and you'll pick up right where you left off.
            </p>
        </article>
    </div>
{{end}}
