{{ if .Error }}
    <p>Error in testing rule: {{ .Error }}</p>
{{ else if .Rule }}
    <p>Matched rule <strong>{{ .Rule.Name }}</strong>.</p>
    {{ if .Rule.Public }}
        <p>This rule gives <span class="badge public-badge">Public Access</span></p>
    {{ else if not .Rule.PermittedRoles }}
        <p>This rule gives <span class="badge admin-badge">Admin Only Access</span></p>
    {{ else }}
        <p>This rule gives access to the following roles:</p>
        <div class="at-badge-row">
            {{ range .Rule.PermittedRoles }}
                <span class="badge role-badge">{{ . }}</span>
            {{ end }}
        </div>
    {{ end }}
{{ else }}
    <p>Did not match a rule. This results in <span class="badge admin-badge">Admin Only Access</span></p>
{{ end }}
