{{template "base.gohtml"}}

{{define "title"}}AuthThingie2 Profile{{end}}

{{define "content"}}
    <div id="self-config-container" class="at-page">
        <hgroup>
            <h1>Your Profile</h1>
            <h2>Editing Yourself (<strong>{{ .User.Username }}</strong>)</h2>
        </hgroup>

        <nav aria-label="breadcrumb">
            <ul>
                <li><a href="/">Home</a></li>
                <li>Edit Profile</li>
            </ul>
        </nav>

        {{ if .Error }}
            <p class="notice">
                Error: {{ .Error }}
            </p>
        {{ end }}

        <div class="grid at-card-grid">
           {{ template "totp_status_fragment.gohtml" . }}
            {{ if .EnablePasskeys }}
                <article>
                    <header>
                        <strong>Passkeys</strong>
                    </header>
                    <div>
                        Sign in with a fingerprint, a face, or a hardware key instead of typing a username and password
                    </div>
                    <footer>
                        <a href="/webauthn/manage">Manage Your Passkeys</a>
                    </footer>
                </article>
            {{ end }}

            <article>
                <header>
                    <strong>Password</strong>
                </header>
                <div>
                    Set a new password. You'll need your current one to do it.
                </div>
                <footer>
                    <a href="/edit_self/password">Change your Password</a>
                </footer>
            </article>
        </div>
    </div>
{{end}}
