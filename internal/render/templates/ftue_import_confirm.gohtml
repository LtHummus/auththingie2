{{template "base.gohtml"}}

{{define "title"}}Confirm Import{{end}}

{{define "content"}}
    <div id="ftue-import-confirm-container" class="ftue-page">
        <hgroup>
            <h1>AuthThingie Import</h1>
            <h2>Confirm Users and Rules</h2>
        </hgroup>

        <p>
            Here's everything I could pull out of your old config file. Nothing has been saved yet, so have a look and make sure it
            all seems right before you commit to it.
        </p>

        <article>
            <header>
                <strong>Users</strong>
            </header>

            {{ if .Users }}
                <figure>
                    <table role="grid">
                        <thead>
                            <tr>
                                <!-- TODO: add duration for rules that have it -->
                                <th scope="col">Username</th>
                                <th scope="col">Password</th>
                                <th scope="col">Roles</th>
                                <th scope="col">TOTP Enabled</th>
                                <th scope="col">Is Admin</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{ range $p := .Users }}
                                <tr>
                                    <td>{{ $p.Username }}</td>
                                    <td>[Password Hashed]</td>
                                    <td>
                                        {{ range $r := $p.Roles }}
                                            <span class="badge role-badge">{{ $r }}</span>
                                        {{ end}}
                                    </td>
                                    <td>{{ if $p.TOTPEnabled }} Yes {{ else }} No {{ end }}</td>
                                    <td>{{ if $p.Admin }} Yes {{ else }} No {{ end }}</td>
                                </tr>
                            {{ end }}
                        </tbody>
                    </table>
                </figure>
                <small>Passwords come across as they were so everyone can keep logging in with the password they already know.</small>
            {{ else }}
                <p class="ftue-empty">I didn't find any users in that config file. You'll be able to create some once setup is done.</p>
            {{ end }}
        </article>

        <article>
            <header>
                <strong>Rules</strong>
            </header>

            {{ if .Rules }}
                <!-- TODO: factor this out in to a fragment -->
                <figure>
                    <table role="grid">
                        <thead>
                        <tr class="table-header">
                            <th scope="col">Rule Name</th>
                            <th scope="col">Source Address</th>
                            <th scope="col">Protocol Pattern</th>
                            <th scope="col">Host Pattern</th>
                            <th scope="col">Path Pattern</th>
                            <th scope="col">Roles</th>
                        </tr>
                        </thead>
                        <tbody>
                        {{ range .Rules }}
                            <tr>
                                <td>{{ .Name }}</td>
                                <td>{{ .Source }}</td>
                                <td>{{ .Protocol }}</td>
                                <td>{{ .Host }}</td>
                                <td>{{ .Path }}</td>
                                <td>
                                    {{ if .IsPublic }}
                                        <span class="badge public-badge">Public</span>
                                    {{ else if .AdminOnly }}
                                        <span class="badge admin-badge">Admin Only</span>
                                    {{ else }}
                                        {{ range .Roles }}
                                            <span class="badge role-badge">{{ . }}</span>
                                        {{ end }}
                                    {{ end }}
                                </td>
                            </tr>
                        {{end}}
                        </tbody>
                    </table>
                </figure>
                <small>Rules are checked in this order, so the first one that matches a request wins.</small>
            {{ else }}
                <p class="ftue-empty">I didn't find any rules in that config file. Everything will be admin only until you add some.</p>
            {{ end }}
        </article>

        <form action="/ftue/import/confirm" method="post">
            <input type="hidden" name="import_key" value="{{ .ImportKey }}" />
            <button type="submit" class="contrast">Looks Good! Import!</button>
        </form>
    </div>
{{end}}
