{{template "base.gohtml"}}

{{define "title"}}AuthThingie 2 Setup{{end}}

{{define "content"}}
    <div id="ftue-scratch" class="ftue-page">
        <hgroup>
            <h1>Starting from Scratch</h1>
            <h2>Admin Account Setup</h2>
        </hgroup>

        {{ if .Error }}
            <div class="error-box" id="ftue-scratch-error">
                ERROR: {{ .Error }}
            </div>
        {{ end }}

        <p>
            This will set up AuthThingie 2 from scratch. All we need right now is the username and password of the admin user. This user
            will be able to create and manage users.
        </p>

        <article>
            <header>
                <strong>Administrator Account</strong>
            </header>

            <form action="/ftue/scratch" method="post">
                <label for="username-field">Username</label>
                <input type="text" name="username" id="username-field" required aria-label="Username" placeholder="Username" />
                <small>This is what you'll type in on the login page. You can add more users once setup is finished.</small>

                <div class="grid">
                    <div>
                        <label for="password-field">Password</label>
                        <input type="password" name="password" id="password-field" required placeholder="Password" aria-label="Password"/>
                    </div>
                    <div>
                        <label for="password2-field">Password (again)</label>
                        <input type="password" name="password2" id="password2-field" required placeholder="Password (again)" aria-label="Password (again)"/>
                    </div>
                </div>
                <small>Pick something good ... this account can do everything, including managing every other user.</small>

                <button type="submit" class="contrast">Create Admin User</button>
            </form>
        </article>

        <p class="ftue-footnote">
            You can turn on two factor authentication and passkeys for this account once you're logged in.
        </p>
    </div>
{{end}}
