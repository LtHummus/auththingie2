{{template "base.gohtml"}}

{{define "title"}}AuthThingie2 Admin Page{{end}}

{{define "content"}}
    <div id="admin-container" class="at-page">
        <hgroup>
            <h1>AuthThingie Admin</h1>
            <h2>Users, rules and a tester (and no oxford comma)</h2>
        </hgroup>

        <nav aria-label="breadcrumb">
            <ul>
                <li><a href="/">Home</a></li>
                <li>Admin Control Panel</li>
            </ul>
        </nav>

        <article id="users-section">
            <header>
                <strong>Users</strong>
            </header>

            {{ if .Users }}
                <figure>
                    <table role="grid">
                        <thead>
                            <tr>
                                <th scope="col">Username</th>
                                <th scope="col">Roles</th>
                                <th scope="col">TOTP</th>
                                <th scope="col">Status</th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {{ range .Users }}
                                <tr>
                                    <td>{{ .Username }}</td>
                                    <td>
                                        {{ if .Admin }}
                                            <span class="badge admin-badge">Admin</span>
                                        {{ end }}
                                        {{ range .Roles }}
                                            <span class="badge role-badge">{{ . }}</span>
                                        {{ end }}
                                    </td>
                                    <td>{{ if .UsesTOTP }}Enabled{{ else }}Not enabled{{ end }}</td>
                                    <td>
                                        {{ if .Disabled }}
                                            <span class="badge admin-badge">Disabled</span>
                                        {{ else }}
                                            Active
                                        {{ end }}
                                    </td>
                                    <td><a href="/admin/users/{{ .Id }}">Edit User</a></td>
                                </tr>
                            {{ end }}
                        </tbody>
                    </table>
                </figure>
            {{ else }}
                <p class="at-empty">There are no users yet. That is a little odd, .... like how is this even being rendered. WTF</p>
            {{ end }}

            <footer>
                <a href="/admin/users/create" role="button">Create a New User</a>
            </footer>
        </article>

        <article id="rules-section">
            <header>
                <strong>Rules</strong>
            </header>

            <p>
                Rules are matched from the top down, and the first one that matches wins. Anything that doesn't match a rule
                is admin only.
            </p>

            {{ if .Rules }}
                <figure>
                    <table id="admin-rule-table" role="grid">
                        <thead>
                            <tr class="table-header">
                                <th scope="col">Rule Name</th>
                                <th scope="col">Source Address</th>
                                <th scope="col">Protocol Pattern</th>
                                <th scope="col">Host Pattern</th>
                                <th scope="col">Path Pattern</th>
                                <th scope="col">Timeout</th>
                                <th scope="col">Roles</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{ range .Rules }}
                                <tr>
                                    <td>{{ .Name }}</td>
                                    <td>{{ .Source }}</td>
                                    <td>{{ .Protocol }}</td>
                                    <td>{{ .Host }}</td>
                                    <td>{{ .Path }}</td>
                                    <td>{{ .Timeout }}</td>
                                    <td>
                                        {{ if .IsPublic }}
                                            <span class="badge public-badge">Public</span>
                                        {{ else if .AdminOnly }}
                                            <span class="badge admin-badge">Admin</span>
                                        {{ else }}
                                            {{ range .Roles }}
                                                <span class="badge role-badge">{{ . }}</span>
                                            {{ end }}
                                        {{ end }}
                                    </td>
                                </tr>
                            {{end}}
                        </tbody>
                    </table>
                </figure>
                <small>Rules live in your config file. Edit it and we'll hot-reload them.</small>
            {{ else }}
                <p class="at-empty">
                    No rules are configured, so every request is admin only. Add some to the <code>rules</code> section of your
                    config file and restart AuthThingie.
                </p>
            {{ end }}
        </article>

        <article id="rule-test-section">
            <header>
                <strong>Test Rule</strong>
            </header>

            <p>Give me a URL and I'll tell you which rule would match it and who would be let through.</p>

            <form hx-get="/admin/ruletest" hx-target="#test-result" hx-swap="innerHTML">
                <div class="grid">
                    <div>
                        <label for="test-source-field">Source IP</label>
                        <input type="text" name="source" id="test-source-field" placeholder="192.168.1.50" />
                        <small>Leave this blank to pretend the request came from the wider internet.</small>
                    </div>
                    <div>
                        <label for="test-url-field">URL</label>
                        <input type="url" inputmode="url" name="url" id="test-url-field" placeholder="https://app.example.com/some/path" />
                        <small>The full URL, scheme and all.</small>
                    </div>
                </div>
                <button type="submit">Test</button>
            </form>

            <div id="test-result"></div>
        </article>
    </div>
{{end}}
